# ═══════════════════════════════════════════════════════════
# Zucker-Held Backend — Umgebungsvariablen
# Kopiere diese Datei nach .env (NIEMALS .env committen!)
# ═══════════════════════════════════════════════════════════

# Datenbank (lokal: aus docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zuckerheld
SPRING_DATASOURCE_USERNAME=zuckerheld
SPRING_DATASOURCE_PASSWORD=zuckerheld_dev_pw

# RabbitMQ (lokal: aus docker-compose.yml)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=zuckerheld
SPRING_RABBITMQ_PASSWORD=zuckerheld_dev_pw

# JWT (min. 256-bit, zufälliger String)
JWT_SECRET=aendere-mich-in-production-mindestens-32-zeichen-lang!!

# AES-Verschlüsselung für API-Keys in DB (genau 32 Zeichen)
ENCRYPTION_KEY=aendere-mich-genau-32-zeichen!!!

# Frontend-URL für CORS
FRONTEND_URL=http://localhost:3000

# Railway Production (werden von Railway automatisch gesetzt):
# DATABASE_URL, PGUSER, PGPASSWORD, PORT

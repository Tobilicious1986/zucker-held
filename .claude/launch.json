{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zucker-held",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "3000", "--host", "127.0.0.1"],
      "port": 3000,
      "autoPort": false,
      "previewUrl": "http://127.0.0.1:3000"
    },
    {
      "name": "zucker-held-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3100"],
      "cwd": "frontend",
      "port": 3100,
      "autoPort": false,
      "previewUrl": "http://127.0.0.1:3100"
    }
  ]
}
